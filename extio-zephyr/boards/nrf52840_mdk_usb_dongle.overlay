/*
 * extio-zephyr on a makerdiary nRF52840 MDK USB Dongle -- the BLE CENTRAL in a
 * USB stick, for a rig whose host has no Ethernet.
 *
 * THIS BOARD IS NOT AN I/O BOX AND THE MAP BELOW SAYS SO. Every other board in
 * boards/ describes a header full of field pins; this one describes three LEDs
 * and nothing else, because that is what the hardware actually offers a box
 * whose job is to relay BLE. The dongle's edge pads are not declared in
 * Zephyr's board files, and inventing entries for pads nobody has confirmed
 * against the silkscreen is precisely the "configuring one silently succeeds
 * while doing nothing electrically" failure this tree keeps paying for. Add
 * them here when someone has a pinout in hand and a meter; until then the box
 * honestly announces three pins, and box_gpio.c refuses every other index
 * (GPIO_DT_SPEC_GET_BY_IDX_OR gives them a NULL port).
 *
 * The counterpart board is boards/xiao_ble.* -- the SAME SoC in the peripheral
 * role. That is why the radio role lives in central.conf / periph.conf rather
 * than in either board file.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	zephyr,user {
		/* The module's RGB LED, ACTIVE_LOW on this board (the flag is what
		 * makes 1 = lit here as everywhere else). Off any connector, so they
		 * cost no field pin, and they give LED_PIN somewhere real to land
		 * instead of main.c's Teensy #else -- the trap that has now caught
		 * two boards on their first boot. */
		box-gpios = <&gpio0 23 GPIO_ACTIVE_LOW>,   /* 0 = LED red   */
			    <&gpio0 22 GPIO_ACTIVE_LOW>,   /* 1 = LED green */
			    <&gpio0 24 GPIO_ACTIVE_LOW>;   /* 2 = LED blue  */

		box-pin-silk = "LEDr","LEDg","LEDb";

		/* NO box-status-rgb YET, and the omission is deliberate:
		 * box_status_led.c only claims its pins under
		 * CONFIG_BOX_BLE_PERIPHERAL, so declaring the property today would
		 * compile a module that then does nothing -- a property that lies
		 * about the board.
		 *
		 * BUT THIS BOARD IS THE STRONGEST CASE FOR A CENTRAL PALETTE. The
		 * dongle ships SEALED IN A CASE: not one pin is reachable, no console
		 * is attached in service, and these three LEDs shining through the
		 * shell are its ENTIRE observable surface. That is a stronger
		 * argument than the handheld had, and the handheld at least has a
		 * button. scanning / linked / fleet-full / radio-fault are all states
		 * a receiver cannot report about itself -- when a central goes deaf,
		 * the silence looks exactly like "no peripherals in range". Declare
		 * this the day box_status_led.c grows a central decide().
		 *
		 * NO box-ain-pins either: no analog pads are broken out that anyone
		 * has confirmed, and CONFIG_ADC stays off in the .conf to match.
		 * Sealed in a case, that is not a limitation -- it is the truth. */
	};
};

/*
 * ---- USB: console FIRST, data SECOND ----
 *
 * Instance order sets USB interface numbering and box_net_usb.c static-asserts
 * it ("cdc_acm_data must be DT instance 1").
 *
 * THE BOARD ALREADY DECLARES A CDC, exactly as the XIAO does:
 * nrf52840_mdk_usb_dongle.dts ends with
 *
 *     #include <../boards/common/usb/cdc_acm_serial.dtsi>
 *
 * which adds `board_cdc_acm_uart` under zephyr_udc0 and points five chosen
 * entries at it. Left in place it takes instance 0, our console becomes 1 and
 * our data pipe becomes 2 -- and the static assert fires, which is the assert
 * doing its job. So delete it and re-point what referenced it.
 *
 * That is only half the fix. The board's Kconfig.defconfig also sources
 * Kconfig.cdc_acm_serial.defconfig, which stands up a SECOND, INDEPENDENT usbd
 * context at boot competing with box_usbd.c's for the one USB peripheral --
 * see CONFIG_CDC_ACM_SERIAL_INITIALIZE_AT_BOOT=n in the .conf, and the XIAO's
 * conf for the full autopsy. Both halves are required; each one alone leaves a
 * box that looks fine from its own side and has no frame pipe.
 *
 * CONSEQUENCE: one USB connector means Zephyr's printk/LOG shares the console
 * CDC with the box CLI and the two interleave. No debugger VCOM exists on this
 * board to separate them, so the CDC default (no BOX_DEFAULT_CONSOLE_MODE gate
 * in CMakeLists.txt) is already right -- the opposite of the DKs.
 */
/ {
	chosen {
		zephyr,console     = &cdc_acm_console;
		zephyr,shell-uart  = &cdc_acm_console;
		zephyr,uart-mcumgr = &cdc_acm_console;
		zephyr,bt-mon-uart = &cdc_acm_console;
		zephyr,bt-c2h-uart = &cdc_acm_console;
	};
};

&zephyr_udc0 {
	/delete-node/ board_cdc_acm_uart;

	cdc_acm_console: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
	cdc_acm_data: cdc_acm_uart1 {
		compatible = "zephyr,cdc-acm-uart";
		rx-fifo-size = <8192>;
		tx-fifo-size = <8192>;
	};
};

/* uart0 is enabled in the board dts on P0.06/P0.07, which are edge pads rather
 * than a debugger VCOM -- nothing is listening unless someone soldered to them.
 * Left enabled (harmless, and it keeps `console uart` available to anyone who
 * does wire it) but never chosen: on this board the CDC is the only console
 * that reaches a host with the cable that powers it. */
