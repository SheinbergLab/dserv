/*
 * extio-zephyr devicetree overlay for the FRDM-RW612.
 */
#include <zephyr/dt-bindings/gpio/gpio.h>   /* GPIO_ACTIVE_LOW, for the mikroBUS CS */

/ {
	aliases {
		box-gpio-port     = &hsgpio0;   /* box pin n -> hsgpio0.n (12 = user LED) */
	};

	/* The box CLI shell owns the USB console CDC; zephyr,console stays on the
	 * board's own UART for Zephyr printk / driver LOG. */
};

/*
 * Enable the ENET IEEE-1588 hardware clock (block #5). The board enables the MAC
 * and MDIO but leaves this node disabled; turning it on instantiates the PTP
 * clock device (PTP_CLOCK_NXP_ENET), the sub-µs sync enabler.
 *
 * `status = "okay"` ALONE IS NOT ENOUGH. Two separate defects sit behind it,
 * both verified on silicon 2026-07-25 against the stock samples/net/ptp:
 *
 *   1. ptp_clock_nxp_enet_init() calls pinctrl_apply_state(DEFAULT)
 *      unconditionally. With no pinctrl-0 the state table is empty,
 *      pinctrl_lookup_state() returns -ENOENT, init fails, and the device
 *      reports DISABLED in `device list` -- presenting as "no PTP hardware"
 *      rather than as a config error.
 *   2. The node's stock `clocks = <&clkctl1 MCUX_ENET_PLL>` names a clock ID
 *      that clock_control_mcux_syscon.c HAS NO CASE FOR. Its get_rate() falls
 *      out of the switch and returns 0 -- SUCCESS -- without ever writing
 *      *rate. ptp_clock_nxp_enet.c:165 casts that return to (void) and passes
 *      the still-uninitialized stack variable to ENET_Ptp1588StartTimer().
 *      Measured effect: the counter ran at a rock-steady 0.14996x real time.
 *      MCUX_ENET_CLK does have a case (CLOCK_GetTddrMciEnetClkFreq = 50 MHz,
 *      the ENET module clock), and with it the counter measures -14 ppm over
 *      121 s.
 *
 * Defect 2 is the nastier one: it fails SILENTLY and in a way that looks like
 * a working clock. Anything that sanity-checks only "does ptp/ns advance?"
 * passes. Check the RATE.
 */
&pinctrl {
	/*
	 * A default pinctrl state purely to satisfy the driver's unconditional
	 * apply -- the counter itself needs no pin.
	 *
	 * PAD CHOICE IS A TRAP. The four 1588 event pads are IO_MUX_ENET_TIMER0..3
	 * = IO27/IO61/IO24/IO26, but pads 24 and 26 are flexcomm3 USART, i.e. THE
	 * CONSOLE on the J-Link VCOM. Muxing one there boots a completely healthy
	 * system with no console -- silent, and easily misread as a boot hang.
	 * The board dts names those pads only via IO_MUX_FC3_USART_DATA, so
	 * grepping the dts for "24" does not find the conflict; decode pad indices
	 * out of build/zephyr/zephyr.dts instead (pad = pinmux value & 0x7F).
	 *
	 * TIMER1 (IO61) is free and off the Arduino header, so it costs no box
	 * pin. TIMER0 (IO27 = Arduino D5) is the header-REACHABLE channel and is
	 * deliberately left free: it is the candidate for a hardware capture
	 * input, which would put a TTL edge directly on the PTP timebase.
	 */
	pinmux_enet_ptp: pinmux_enet_ptp {
		group0 {
			pinmux = <IO_MUX_ENET_TIMER1>;
			slew-rate = "normal";
		};
	};
};

&enet_ptp_clock {
	status = "okay";
	pinctrl-0 = <&pinmux_enet_ptp>;
	pinctrl-names = "default";
	clocks = <&clkctl1 MCUX_ENET_CLK>;
};

/*
 * Two USB CDC-ACM instances on the HS device controller (block #4):
 *   cdc_acm_console -- the human text console / bootstrap CLI   (if00 / *1 tty)
 *   cdc_acm_data    -- the binary 128-byte dserv frame pipe     (if02 / *3 tty)
 * This is the "config alongside the data pump" split: both channels are the same
 * USB primitive, differentiated by role. The frame pipe can later move to raw
 * vendor bulk endpoints without touching the box logic (see BENCH_NXP.md D1/D2).
 *
 * ORDER IS PART OF THE CONTRACT -- console FIRST, data SECOND. Instance order
 * sets USB interface numbering, and the dserv host module finds the data pipe at
 * if02 on Linux (`*extio*if02*`) and the *3 tty on macOS. Declaring data first
 * makes dserv open the CONSOLE, steal its bytes, and reopen it every 2 s.
 */
&zephyr_udc0 {
	cdc_acm_console: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
	cdc_acm_data: cdc_acm_uart1 {
		compatible = "zephyr,cdc-acm-uart";
	};
};

/*
 * Box GPIO pads (loopback / real I/O).
 *
 * box pin n -> hsgpio0.n, so a pin is usable ONLY if pad n is muxed to GPIO.
 * The board's own pinmux_hsgpio0 muxes just [0, 1, 11, 12, 18, 21], and of
 * those 12 is the user LED, 21 is the ENET PHY interrupt, and 11 is the SW2
 * button -- leaving pin 18 as the single free box pin, i.e. no loopback pair
 * and no way to prove DI at all.
 *
 * A pad that is NOT muxed to GPIO still accepts `pin <n> mode out` and reports
 * itself in state/pins/out while doing NOTHING electrically. That silent
 * success is the same failure shape as the PTP clock-rate bug -- check the pad,
 * not the acknowledgement.
 *
 * Added here, all verified free against the EXPANDED devicetree (decode
 * `pinmux` cells in build/zephyr/zephyr.dts, pad = value & 0x7F -- macro greps
 * miss conflicts, which is how pad 24 = console was nearly muxed away):
 *
 *   pad 15 -> Arduino D3
 *   pad 20 -> Arduino D7
 *   pad 27 -> Arduino D5   (also ENET_TIMER0; free because PTP uses TIMER1/IO61)
 *
 * With pad 0 (Arduino D6) already muxed by the board, the usable box pins are
 * 0, 15, 18, 20, 27 -- plus 11 (SW2, input) and 12 (LED, output).
 * Reserved on this board: 11, 12, 21, 24, 26, 61.
 */
&pinctrl {
	pinmux_box_gpio: pinmux_box_gpio {
		group0 {
			pinmux = <IO_MUX_GPIO15
				  IO_MUX_GPIO20
				  IO_MUX_GPIO27
				  /* mikroBUS CS. Freeing IO10 from the flexcomm SS1
				   * function is not enough -- the pad still has to be
				   * muxed TO GPIO for a cs-gpios write to reach it.
				   * Without this the select floated: MISO was undriven
				   * and every sample came back rail-to-rail (0 / 4095)
				   * instead of a resting stick's mid-scale. */
				  IO_MUX_GPIO10>;
			slew-rate = "normal";
		};
	};
};

&hsgpio0 {
	pinctrl-0 = <&pinmux_hsgpio0 &pinmux_box_gpio>;
	pinctrl-names = "default";
};

/* ---- analog input: MCP3204 on the mikroBUS socket ----
 *
 * The board brings the mikroBUS SPI out as flexcomm1 (`mikrobus_spi: &flexcomm1`
 * in frdm_rw612_common.dtsi) but leaves it disabled with no pinctrl, so the app
 * supplies both. CS is the socket's own CS pin via the mikrobus_header gpio-map,
 * which keeps this correct for ANY Click board rather than hardcoding a pad.
 *
 * Declares the DEVICE only, no channel@N children. Channels are configured at
 * runtime by box_adc.c because the sweep mask is a runtime property (a box may
 * be told to sample 2 channels for a joystick or 4 for an eye feed), and because
 * the same code then drives an 8-channel part with no devicetree edit.
 *
 * 1 MHz is the MCP3204's ceiling at 3.3 V for rated accuracy -- the datasheet
 * derates below 2.7 V, and the RP2350 driver settled on the same number. A
 * 4-channel sweep is then ~100 us, which is why sampling never runs on the
 * service loop.
 */
/* Mux ONLY the three data signals, so IO10 stays a plain GPIO for the chip
 * select. The board's pinmux_flexcomm1_spi cannot be used here: its names are
 * misleading -- IO_MUX_FC1_SPI_SS0 is not "the SS0 pin" but a composite muxing
 * IO6/7/8/9, and SS1 muxes IO7/8/9/10 -- so including it hands IO10 to the
 * flexcomm peripheral as a hardware select, and a cs-gpios write to that pad
 * goes nowhere. That is why every sample read exactly 0: clock and data were
 * fine, nothing ever asserted CS, and the MCP3204 never drove MISO.
 *
 * The per-pin macros are what make this expressible. mikroBUS wiring on this
 * board: SCK=IO7, MISO=IO8, MOSI=IO9, CS=IO10. */
&pinctrl {
	pinmux_box_mikrobus_spi: pinmux_box_mikrobus_spi {
		group0 {
			pinmux = <IO_MUX_FC1_SPI_SS0_IO7      /* SCK  */
				  IO_MUX_FC1_SPI_SS0_IO8      /* MISO */
				  IO_MUX_FC1_SPI_SS0_IO9>;    /* MOSI */
			slew-rate = "ultra";
		};
	};
};

&mikrobus_spi {
	status = "okay";
	pinctrl-0 = <&pinmux_box_mikrobus_spi>;
	pinctrl-names = "default";
	#address-cells = <1>;
	#size-cells = <0>;

	/* GPIO chip select, and reg = <0>.
	 *
	 * This SoC's flexcomm SPI has exactly ONE hardware select: the driver
	 * computes max_slave from FSL_FEATURE_SPI_SSEL_COUNT and rejected reg = <1>
	 * outright with `Slave 1 is greater than max 0`, timing out every transfer.
	 * So the socket's CS on IO10 has to be driven as a GPIO, and `reg` indexes
	 * the cs-gpios list rather than a hardware select. */
	cs-gpios = <&mikrobus_header 2 GPIO_ACTIVE_LOW>;

	box_adc: adc@0 {
		compatible = "microchip,mcp3204";
		reg = <0>;
		spi-max-frequency = <1000000>;
		#io-channel-cells = <1>;
		#address-cells = <1>;
		#size-cells = <0>;
	};
};
