#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/mcux-lpadc.h>
#include <zephyr/dt-bindings/regulator/nxp_vref.h>

/*
 * extio-zephyr devicetree overlay for the FRDM-MCXN947.
 *
 * Why this board exists in the tree: the RW612 is a tri-radio part we were
 * using with the radios off, and it has no analog front end worth the name.
 * The MCXN947 trades the radios for on-chip LPADC + DAC + OPAMP and keeps the
 * things the port depends on -- Ethernet with an IEEE-1588 clock, USB HS, and
 * a real MCUboot flash layout.
 *
 * ENET_QOS IS A DIFFERENT IP FROM THE RW612'S ENET. Every timing number
 * recorded for the RW612 has to be re-measured here; none of it transfers.
 *
 * FILE NAME GOTCHA -- this is the first board in the tree with hardware-model-v2
 * QUALIFIERS (`frdm_mcxn947/mcxn947/cpu0`, vs the bare `teensy41`/`frdm_rw612`).
 * Zephyr's automatic board-overlay search builds its candidate names from
 * BOARD + BOARD_QUALIFIERS (zephyr_build_string MERGE), and MERGE adds only the
 * board+qualifiers variant -- NOT the bare board name. So `frdm_mcxn947.overlay`
 * is never looked at: it sits in boards/ being silently ignored while the build
 * fails on the alias it defines. The name must carry the qualifiers, with `/`
 * replaced by `_`. Same rule for the matching .conf.
 */

/ {
	aliases {
		/*
		 * box pin n -> gpio0.n.
		 *
		 * gpio0 is the right port on this board for two reasons:
		 *   1. it carries 11 of the Arduino header pins inside the box's
		 *      0..29 index range (BOX_NPINS = 30, a frozen core constant):
		 *
		 *        box 10 = D9  (P0_10, also the RED LED)
		 *        box 14 = A2  (P0_14)
		 *        box 15 = A4  (P0_15)
		 *        box 22 = A3  (P0_22)
		 *        box 23 = A5  (P0_23, also SW2 -- the user button)
		 *        box 24 = D11 (P0_24, Arduino MOSI)
		 *        box 25 = D13 (P0_25, Arduino SCK)
		 *        box 26 = D12 (P0_26, Arduino MISO)
		 *        box 27 = D10 (P0_27, Arduino CS, also the GREEN LED)
		 *        box 28 = D8  (P0_28)
		 *        box 29 = D2  (P0_29)
		 *
		 *      (D4 = P0_30 and D7 = P0_31 exist but fall outside BOX_NPINS.)
		 *   2. ENET_QOS uses NONE of port 0 -- its RMII/MDIO pads are all on
		 *      port 1 (P1_4..7, P1_13..15, P1_20/21). Picking gpio1 would put
		 *      box pins straight on top of the PHY.
		 *
		 * NO pinmux group is needed for these, unlike the RW612. Zephyr's
		 * gpio_mcux driver writes PORT_PCR_MUX(PORT_MUX_GPIO) itself in
		 * pin_configure(), so claiming a box pin muxes the pad to GPIO as a
		 * side effect. The RW612's "a pad not muxed to GPIO accepts every
		 * command and does nothing electrically" trap does not exist here.
		 */
		box-gpio-port = &gpio0;
	};
};

/*
 * Two USB CDC-ACM instances on the HS device controller (usb1 = nxp,ehci
 * behind usbphy1), exactly as on the other boards:
 *   cdc_acm_console -- the human text console / bootstrap CLI   (if00 / *1 tty)
 *   cdc_acm_data    -- the binary 128-byte dserv frame pipe     (if02 / *3 tty)
 *
 * ORDER IS PART OF THE CONTRACT -- console FIRST, data SECOND. Instance order
 * sets USB interface numbering, and the dserv host module finds the data pipe
 * at if02 on Linux and the *3 tty on macOS. box_net_usb.c static-asserts it.
 */
&zephyr_udc0 {
	cdc_acm_console: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
	cdc_acm_data: cdc_acm_uart1 {
		compatible = "zephyr,cdc-acm-uart";
	};
};

/* ---- analog input: the ON-CHIP LPADC ----
 *
 * `box_adc:` relabels the SoC's lpadc0 as the box's converter, which is all
 * box_adc.c binds to. No SPI, no chip select -- the whole class of problem that
 * parked the MCP3204 on the RW612 does not exist here.
 *
 * PIN CHOICE: the three pads the board ALREADY muxes, and NO pinmux change.
 * `pinmux_lpadc0` in frdm_mcxn947-pinctrl.dtsi brings out exactly:
 *
 *   ADC0_A1 = P4_15   -> box ain channel 0
 *   ADC0_B1 = P4_19   -> box ain channel 1
 *   ADC0_A2 = P4_23   -> box ain channel 2
 *
 * These are J8 pins 20 / 24 / 28 (samples/drivers/adc/adc_dt names them). Three
 * single-ended channels covers an eye feed's X / Y / pupil.
 *
 * WHY NOT THE ARDUINO ANALOG STRIP. A2/A3/A4/A5 are P0_14 / P0_22 / P0_15 /
 * P0_23 = ADC0 B14 / A14 / B15 / A15, so they work -- but port 0 is
 * `box-gpio-port`, so every analog pin taken there DELETES a digital box pin. Those
 * four are box pins 14, 22, 15, 23 (and 23 is SW2). We have 11 digital pins;
 * spending 4 of them on channels we do not yet need is the wrong trade. The
 * port-4 pads cost nothing because the box has no digital claim on port 4.
 * Documented as the extension path when a 4th+ channel is actually wanted.
 *
 * THE CHANNEL MAP IS THE POINT. box_adc.c used to assume channel n IS input n,
 * which is true of an MCP3204 and false here: `channel_id` indexes a CMD-register
 * slot and `zephyr,input-positive` picks the physical input. Declaring the map
 * in devicetree is what makes the box's flat wire index (`ain group G channels
 * 0,1`) resolve to a specific pad -- and keeps that resolution a BOARD property,
 * exactly like the pin-map proposal in PORTING.md.
 */
&vref {
	/* Only actually used in EXTERNAL1 mode, which we do NOT use (see below).
	 * Left configured so that switching a channel back to the precision 1.8 V
	 * reference is a one-line change and not a re-derivation. */
	regulator-initial-mode = <NXP_VREF_MODE_HIGH_POWER>;
};

box_adc: &lpadc0 {
	#address-cells = <1>;
	#size-cells = <0>;

	/*
	 * ---- 3300 mV FULL SCALE, MEASURED, NOT ASSUMED ----
	 *
	 * The board's own dts sets `voltage-ref = <1>`, which is the on-chip VREF
	 * regulator. That caps at 2.1 V (`regulator-max-microvolt`) and the in-tree
	 * sample runs it at 1.8 V -- and **an Eyelink-style 0-3.3 V feed does not
	 * fit in 1.8 V**. It is not a tuning knob; the regulator cannot go there.
	 *
	 * CFG[REFSEL] is the way out, but the FSL headers only call the options
	 * Alt1/Alt2/Alt3, so which one is VDDA is a reference-manual question. It
	 * was settled instead by MEASUREMENT, using the `adccal` DAC->ADC sweep
	 * (box_console.c) with a jumper from DAC0_OUT (P4_2 / J1-4) to J8-20:
	 *
	 *   voltage-ref = 1   ADC saturates at DAC code ~2256      -> full scale 1.8 V
	 *   voltage-ref = 0   NO saturation, adc_code == dac_code   -> full scale = the DAC's
	 *   voltage-ref = 2   identical to 0
	 *   voltage-ref = 3   identical to 0
	 *
	 * A 12-bit DAC and a 12-bit ADC reading code-for-code (1023->1026,
	 * 2047->2052, 3071->3076, 4095->4094) is the signature of the two SHARING a
	 * reference. Chained with the earlier run -- where a known-1.8 V ADC
	 * reference implied a 3.3 V DAC to within ~1% -- that puts this at ~3.3 V.
	 *
	 * So no divider and no OPAMP are needed for a 0-3.3 V source; it is a
	 * devicetree line. `zephyr,reference` must be EXTERNAL0 for this: EXTERNAL1
	 * makes the driver program the vref regulator and use it instead.
	 *
	 * THE TRADE, stated because it is a real one: full scale 3.3 V gives
	 * 0.81 mV/LSB against 0.44 mV/LSB at 1.8 V -- half the resolution -- and
	 * VDDA is a noisier reference than a dedicated bandgap. For a 0-3.3 V eye
	 * feed the range is not optional. For a low-range precision signal, put
	 * that channel back on EXTERNAL1 + `voltage-ref = <1>` and 1800 mV.
	 *
	 * A JOYSTICK NEEDS NEITHER, and this is worth knowing before anyone builds
	 * a divider for one: a joystick is a potentiometer, so its output span is
	 * whatever supply drives it. Power the pot from the reference and it is
	 * ratiometric -- reference drift cancels out of the measurement entirely.
	 */
	voltage-ref = <0>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_EXTERNAL0";
		zephyr,vref-mv = <3300>;
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
		zephyr,input-positive = <MCUX_LPADC_CH1A>;   /* P4_15, J8-20 */
	};

	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_EXTERNAL0";
		zephyr,vref-mv = <3300>;
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
		zephyr,input-positive = <MCUX_LPADC_CH1B>;   /* P4_19, J8-24 */
	};

	channel@2 {
		reg = <2>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_EXTERNAL0";
		zephyr,vref-mv = <3300>;
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
		zephyr,input-positive = <MCUX_LPADC_CH2A>;   /* P4_23, J8-28 */
	};
};
