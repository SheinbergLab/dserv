#include <zephyr/dt-bindings/gpio/gpio.h>      /* GPIO_ACTIVE_LOW for the LEDs */
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/mcux-lpadc.h>
#include <zephyr/dt-bindings/regulator/nxp_vref.h>

/*
 * extio-zephyr devicetree overlay for the FRDM-MCXN947.
 *
 * Why this board exists in the tree: the RW612 is a tri-radio part we were
 * using with the radios off, and it has no analog front end worth the name.
 * The MCXN947 trades the radios for on-chip LPADC + DAC + OPAMP and keeps the
 * things the port depends on -- Ethernet with an IEEE-1588 clock, USB HS, and
 * a real MCUboot flash layout.
 *
 * ENET_QOS IS A DIFFERENT IP FROM THE RW612'S ENET. Every timing number
 * recorded for the RW612 has to be re-measured here; none of it transfers.
 *
 * FILE NAME GOTCHA -- this is the first board in the tree with hardware-model-v2
 * QUALIFIERS (`frdm_mcxn947/mcxn947/cpu0`, vs the bare `teensy41`/`frdm_rw612`).
 * Zephyr's automatic board-overlay search builds its candidate names from
 * BOARD + BOARD_QUALIFIERS (zephyr_build_string MERGE), and MERGE adds only the
 * board+qualifiers variant -- NOT the bare board name. So `frdm_mcxn947.overlay`
 * is never looked at: it sits in boards/ being silently ignored while the build
 * fails on the alias it defines. The name must carry the qualifiers, with `/`
 * replaced by `_`. Same rule for the matching .conf.
 */

/ {
	/*
	 * ---- THE PIN MAP: box pin n IS Arduino Dn ----
	 *
	 * The old scheme was one alias, `box pin n -> gpio0.n`, which had two
	 * costs. Six of the fourteen Arduino digital pins live on gpio1/gpio4 and
	 * were simply UNREACHABLE; and the numbering was scrambled against the
	 * silkscreen (box 24 was D11, box 26 was D12), which cost bench time every
	 * single session and needed a doc lookup to answer "which pins do I jumper".
	 *
	 * Now box pin n resolves to whatever this list says, so the box pin number
	 * IS the number printed on the board. `cmd/do/11` drives the pin labelled
	 * D11. Nothing on the wire changed -- the contract was always a flat index,
	 * it just resolves somewhere a human can find.
	 *
	 * D5 IS DECLARED AND RESERVED. P1_21 is ENET0_MDIO: the pin exists on the
	 * header, it belongs to the PHY, and claiming it would take the box off the
	 * network. Listing it and refusing it beats omitting it -- the map then
	 * describes the whole header, and the reason lives next to the pin.
	 *
	 * THE TWO LEDs CARRY GPIO_ACTIVE_LOW, which is the whole reason the flags
	 * matter. The board wires both LEDs active-low, so before this an
	 * obs-mirror on the green LED lit BETWEEN observation periods and went dark
	 * DURING them -- backwards, and confirmed backwards on the bench. With the
	 * flag, `obs pin 10` lights the LED for the duration of the obs period,
	 * because gpio_pin_set_dt() applies the polarity the board declared. Note
	 * this makes `do 10 1` light the LED too: on this board that pad IS the LED.
	 *
	 * NO pinmux group is needed for any of these. Zephyr's gpio_mcux driver
	 * writes PORT_PCR_MUX(PORT_MUX_GPIO) in pin_configure(), so claiming a box
	 * pin muxes the pad as a side effect -- the RW612's "a pad not muxed to
	 * GPIO accepts every command and does nothing electrically" trap does not
	 * exist here.
	 */
	zephyr,user {
		box-gpios = <&gpio4  3 0>,                 /*  0 = D0   (P4_3)  */
			    <&gpio4  2 0>,                 /*  1 = D1   (P4_2, also DAC0_OUT) */
			    <&gpio0 29 0>,                 /*  2 = D2   (P0_29) */
			    <&gpio1 23 0>,                 /*  3 = D3   (P1_23) */
			    <&gpio0 30 0>,                 /*  4 = D4   (P0_30) */
			    <&gpio1 21 0>,                 /*  5 = D5   RESERVED: ENET0_MDIO */
			    <&gpio1  2 0>,                 /*  6 = D6   (P1_2, also BLUE LED) */
			    <&gpio0 31 0>,                 /*  7 = D7   (P0_31) */
			    <&gpio0 28 0>,                 /*  8 = D8   (P0_28) */
			    <&gpio0 10 GPIO_ACTIVE_LOW>,   /*  9 = D9   (P0_10, RED LED)   */
			    <&gpio0 27 GPIO_ACTIVE_LOW>,   /* 10 = D10  (P0_27, GREEN LED) */
			    <&gpio0 24 0>,                 /* 11 = D11  (P0_24, MOSI) */
			    <&gpio0 26 0>,                 /* 12 = D12  (P0_26, MISO) */
			    <&gpio0 25 0>,                 /* 13 = D13  (P0_25, SCK)  */
			    <&gpio0 14 0>,                 /* 14 = A2   (P0_14) */
			    <&gpio0 22 0>,                 /* 15 = A3   (P0_22) */
			    <&gpio0 15 0>,                 /* 16 = A4   (P0_15) */
			    <&gpio0 23 0>;                 /* 17 = A5   (P0_23, also SW2) */

		/* Bytestring, NOT <5>: a one-element <> infers a SCALAR int and
		 * `uint8_t rsv[] = DT_PROP(...)` then fails to compile. [] is always a
		 * uint8-array however many entries it has. */
		box-reserved = [05];                       /* D5 = ENET0_MDIO, the PHY's */

		/* Which box pin each ain channel shares, indexed by ain channel;
		 * 0xff = a DEDICATED pad that is not a box pin at all, so that
		 * channel is always analog. A channel bound to a box pin is
		 * samplable only while that pin is in `ain` mode.
		 *
		 * ain channel k IS Arduino Ak -- the analog twin of "box pin n IS
		 * Dn". ch0/1 = ADC0_A0/ADC0_B0, dedicated ANALOG-ONLY package pads
		 * wired straight to A0/A1: no port, no GPIO function, which is why
		 * Zephyr's arduino_header gpio-map starts at A2 and why they cost
		 * nothing here. ch2-5 = box pins 14-17 (A2-A5), ordinary digital
		 * pins until someone says `pin 14 mode ain`.
		 *
		 * The BOARD declares what is possible; the CONFIG decides what is
		 * used. That split is why analog allocation no longer needs a
		 * firmware rebuild -- which matters because every other setting on
		 * this box is runtime and persisted, and one exception means an
		 * image per rig. */
		box-ain-pins = [ff ff 0e 0f 10 11];
	};
};

/*
 * Two USB CDC-ACM instances on the HS device controller (usb1 = nxp,ehci
 * behind usbphy1), exactly as on the other boards:
 *   cdc_acm_console -- the human text console / bootstrap CLI   (if00 / *1 tty)
 *   cdc_acm_data    -- the binary 128-byte dserv frame pipe     (if02 / *3 tty)
 *
 * ORDER IS PART OF THE CONTRACT -- console FIRST, data SECOND. Instance order
 * sets USB interface numbering, and the dserv host module finds the data pipe
 * at if02 on Linux and the *3 tty on macOS. box_net_usb.c static-asserts it.
 */
&zephyr_udc0 {
	cdc_acm_console: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
	cdc_acm_data: cdc_acm_uart1 {
		compatible = "zephyr,cdc-acm-uart";
	};
};

/*
 * ---- a STABLE MAC, and why this is not cosmetic ----
 *
 * frdm_mcxn947.dtsi:361 sets `zephyr,random-mac-address`, so this board synthesises
 * a locally-administered MAC with THREE RANDOM LOW BYTES AT EVERY BOOT. Unlike the
 * RW612 -- whose MAC comes out of the wireless OTP and is therefore stable --
 * nothing here is fused, so the board has no persistent identity unless we give it
 * one.
 *
 * Two consequences, neither of which looks like a MAC problem when you hit it:
 *
 *   1. DHCP hands out a NEW LEASE EVERY REBOOT (.45 -> .46 -> .47 -> .48 across
 *      four reboots in one session), because the server correctly sees a new
 *      client each time. A static lease CANNOT fix this -- static leases are keyed
 *      on the MAC, which is the unstable thing.
 *   2. PTP `clockIdentity` IS DERIVED FROM THE MAC, so the box's PTP identity
 *      changes every boot too. A grandmaster sees a brand-new clock after each
 *      reset, and two identities observed an hour apart (ae9a22.fffe.062efb and
 *      ae9a22.fffe.fa28e2) were the SAME BOX -- which sent me hunting for a second
 *      PTP clock on the LAN that did not exist.
 *
 * DELETING THE RANDOM PROPERTY IS LOAD-BEARING, not tidiness. Per the binding,
 * `nxp,unique-mac` "will be overridden if the node has zephyr,random-mac-address or
 * local-mac-address also" -- so leaving either in place makes this whole block a
 * silent no-op that reads correctly and changes nothing. That is the same failure
 * shape as the un-qualified board overlay on day one.
 *
 * WHY unique-mac RATHER THAN THE PRINTED ADDRESS. Each board has a real NXP MAC
 * printed on it (00:04:9F:09:D9:C4 and 00:04:9F:09:CA:BF here), and using those
 * would be globally unique -- but it needs ONE IMAGE PER BOARD, which breaks the
 * single-image OTA shelf. `nxp,unique-mac` derives the low 3 bytes from a CRC of
 * the silicon UID under the Freescale OUI with the LAA bit set, giving a STABLE
 * per-chip address from ONE binary for the whole fleet.
 *
 * The bug we needed to fix was INSTABILITY, not lack of global uniqueness, and this
 * fixes that. Note upstream frames the option as bringup-grade -- "a very low
 * likelihood that the mac address is the same as another on the network ... such
 * as, testing, bringup, demos" -- because it is a 24-bit hash. For a handful of rig
 * boxes that is fine; if it ever is not, the printed MACs are the fallback, at the
 * cost of per-board builds.
 */
&enet_mac {
	/delete-property/ zephyr,random-mac-address;
	nxp,unique-mac;
};

/* ---- analog input: the ON-CHIP LPADC ----
 *
 * `box_adc:` relabels the SoC's lpadc0 as the box's converter, which is all
 * box_adc.c binds to. No SPI, no chip select -- the whole class of problem that
 * parked the MCP3204 on the RW612 does not exist here.
 *
 * PIN CHOICE: the Arduino analog strip, ALL SIX of it -- ain channel k IS Ak,
 * the analog twin of the digital map above. The UNO header is the box's ONE
 * field connector (a screw-terminal or custom shield reaches every box pin,
 * digital AND analog), and per UM12018 Table 20 every A position lands on
 * THIS converter:
 *
 *   ch0 = A0 = ADC0_A0 (CH0A)    ch1 = A1 = ADC0_B0 (CH0B)
 *   ch2 = A2 = P0_14   (CH14B)   ch3 = A3 = P0_22   (CH14A)
 *   ch4 = A4 = P0_15   (CH15B)   ch5 = A5 = P0_23   (CH15A)
 *
 * A0/A1 are the find that made this free: DEDICATED analog-only package pads,
 * not port pins -- no GPIO function, no pinmux, no digital cost, and the
 * reason Zephyr's arduino_header gpio-map starts at A2 (there is no gpio to
 * map). No second converter either: D3 is the only ADC1 pin on the header and
 * it stays digital.
 *
 * SUPERSEDES the J8 scheme (ch0-2 = P4_15/P4_19/P4_23 = J8-20/24/28, ch3-5 =
 * A2/A3/A4), which optimised for zero digital-pin cost back when the box had
 * 11 digital pins and no per-pin map. With the map, ch2-5 are runtime
 * dual-purpose, so the standing cost is zero until a rig actually says
 * `pin N mode ain` -- and one shield that reaches everything is worth more
 * than three always-on pads off-header. MIGRATION for rigs wired to J8: the
 * old ch3/4/5 are the new ch2/3/4. Persisted group configs keep their channel
 * INDICES and those indices now resolve one A position over -- re-jumper
 * (J8-20/24/28 wiring lands on A0/A1/A2), re-check `ain group` definitions,
 * re-run eye calibration. The J8 pads remain the proven zero-cost pool if
 * ch6/7 (AIN_MAX_CH = 8) are ever fitted, at the price of leaving the shield.
 *
 * THE CHANNEL MAP IS THE POINT. box_adc.c used to assume channel n IS input n,
 * which is true of an MCP3204 and false here: `channel_id` indexes a CMD-register
 * slot and `zephyr,input-positive` picks the physical input. Declaring the map
 * in devicetree is what makes the box's flat wire index (`ain group G channels
 * 0,1`) resolve to a specific pad -- and keeps that resolution a BOARD property,
 * exactly like the pin-map proposal in PORTING.md.
 */
/* The four port-0 pads behind ain channels 2-5 (A2-A5). A0/A1 appear in no
 * pinctrl group because dedicated pads have no PORT function to mux. A port
 * pad left out of this group stays muxed as GPIO and the converter reads a
 * disconnected input -- a silent wrong answer, the same shape as the RW612's
 * un-muxed digital pads. */
&pinctrl {
	pinmux_box_ain: pinmux_box_ain {
		group0 {
			pinmux = <ADC0_B14_PIO0_14>,   /* A2 */
				 <ADC0_A14_PIO0_22>,   /* A3 */
				 <ADC0_B15_PIO0_15>,   /* A4 -- via SJ8, default 1-2 */
				 <ADC0_A15_PIO0_23>;   /* A5 -- net shared with SW2 */
			slew-rate = "fast";
			drive-strength = "low";
		};
	};
};

&vref {
	/* Only actually used in EXTERNAL1 mode, which we do NOT use (see below).
	 * Left configured so that switching a channel back to the precision 1.8 V
	 * reference is a one-line change and not a re-derivation. */
	regulator-initial-mode = <NXP_VREF_MODE_HIGH_POWER>;
};

box_adc: &lpadc0 {
	#address-cells = <1>;
	#size-cells = <0>;

	/* ONLY our group. Overriding pinctrl-0 REPLACES the board's value, and
	 * that is now the intent: the board's `pinmux_lpadc0` (the three J8
	 * pads) retires with the J8 channels -- an analog-muxed pad no channel
	 * reads is the misleading kind of tidy. */
	pinctrl-0 = <&pinmux_box_ain>;
	pinctrl-names = "default";

	/*
	 * ---- 3300 mV FULL SCALE, MEASURED, NOT ASSUMED ----
	 *
	 * The board's own dts sets `voltage-ref = <1>`, which is the on-chip VREF
	 * regulator. That caps at 2.1 V (`regulator-max-microvolt`) and the in-tree
	 * sample runs it at 1.8 V -- and **an Eyelink-style 0-3.3 V feed does not
	 * fit in 1.8 V**. It is not a tuning knob; the regulator cannot go there.
	 *
	 * CFG[REFSEL] is the way out, but the FSL headers only call the options
	 * Alt1/Alt2/Alt3, so which one is VDDA is a reference-manual question. It
	 * was settled instead by MEASUREMENT, using the `adccal` DAC->ADC sweep
	 * (box_console.c) with a jumper from DAC0_OUT (P4_2 / J1-4) to J8-20 --
	 * which was ain ch0 at the time; on the Arduino map the same sweep is a
	 * jumper from D1 to A0, two positions on the same header:
	 *
	 *   voltage-ref = 1   ADC saturates at DAC code ~2256      -> full scale 1.8 V
	 *   voltage-ref = 0   NO saturation, adc_code == dac_code   -> full scale = the DAC's
	 *   voltage-ref = 2   identical to 0
	 *   voltage-ref = 3   identical to 0
	 *
	 * A 12-bit DAC and a 12-bit ADC reading code-for-code (1023->1026,
	 * 2047->2052, 3071->3076, 4095->4094) is the signature of the two SHARING a
	 * reference. Chained with the earlier run -- where a known-1.8 V ADC
	 * reference implied a 3.3 V DAC to within ~1% -- that puts this at ~3.3 V.
	 *
	 * So no divider and no OPAMP are needed for a 0-3.3 V source; it is a
	 * devicetree line. `zephyr,reference` must be EXTERNAL0 for this: EXTERNAL1
	 * makes the driver program the vref regulator and use it instead.
	 *
	 * THE TRADE, stated because it is a real one: full scale 3.3 V gives
	 * 0.81 mV/LSB against 0.44 mV/LSB at 1.8 V -- half the resolution -- and
	 * VDDA is a noisier reference than a dedicated bandgap. For a 0-3.3 V eye
	 * feed the range is not optional. For a low-range precision signal, put
	 * that channel back on EXTERNAL1 + `voltage-ref = <1>` and 1800 mV.
	 *
	 * A JOYSTICK NEEDS NEITHER, and this is worth knowing before anyone builds
	 * a divider for one: a joystick is a potentiometer, so its output span is
	 * whatever supply drives it. Power the pot from the reference and it is
	 * ratiometric -- reference drift cancels out of the measurement entirely.
	 */
	voltage-ref = <0>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_EXTERNAL0";
		zephyr,vref-mv = <3300>;
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
		zephyr,input-positive = <MCUX_LPADC_CH0A>;   /* ADC0_A0, Arduino A0 */
	};

	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_EXTERNAL0";
		zephyr,vref-mv = <3300>;
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
		zephyr,input-positive = <MCUX_LPADC_CH0B>;   /* ADC0_B0, Arduino A1 */
	};

	channel@2 {
		reg = <2>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_EXTERNAL0";
		zephyr,vref-mv = <3300>;
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
		zephyr,input-positive = <MCUX_LPADC_CH14B>;  /* P0_14, Arduino A2 */
	};

	/* ---- channels 2-5: the shared half of the strip ----
	 * These share box pins 14-17 (A2-A5) via `box-ain-pins` above: digital
	 * until `pin N mode ain`, and box_ain intersects each group mask with
	 * what is actually analog, so a group never carries a stale value for a
	 * pin that went digital. (v1 put 14-16 in `box-reserved` for a blanket
	 * refusal; the runtime-mode commit replaced that with gating but this
	 * comment kept claiming the reservation for two more commits.
	 * Reservation is for pads the box must NEVER touch, like D5/MDIO --
	 * mode gating is what arbitrates a pad two subsystems legitimately
	 * share.)
	 *
	 * TWO CAVEATS THAT LIVE ON THE BOARD, NOT IN THIS FILE:
	 *  - A4/P0_15 reaches the header through solder jumper SJ8 (default
	 *    1-2 = ADC; 2-3 reroutes the position to P2_0/TRIG_IN5). A board
	 *    with SJ8 flipped reads a disconnected input, silently.
	 *  - A5/P0_23 is ALSO SW2: the net is pulled up to 3V3 and the button
	 *    SHORTS IT TO GROUND -- including whatever the rig wired to the A5
	 *    terminal. Unloaded it idles at ~3.3 V. The compromised position:
	 *    allocate it LAST, never to a source that minds a dead short. */
	channel@3 {
		reg = <3>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_EXTERNAL0";
		zephyr,vref-mv = <3300>;
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
		zephyr,input-positive = <MCUX_LPADC_CH14A>;  /* P0_22, Arduino A3 */
	};

	channel@4 {
		reg = <4>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_EXTERNAL0";
		zephyr,vref-mv = <3300>;
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
		zephyr,input-positive = <MCUX_LPADC_CH15B>;  /* P0_15, Arduino A4 */
	};

	channel@5 {
		reg = <5>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_EXTERNAL0";
		zephyr,vref-mv = <3300>;
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
		zephyr,input-positive = <MCUX_LPADC_CH15A>;  /* P0_23, Arduino A5 */
	};
};
