+				 * taken immediately after the data descriptor can legally
+				 * observe it still DMA-owned -- and the original code then
+				 * dropped the timestamp silently and moved on.
+				 *
+				 * The failure mode that costs you a day: the PTP stack logs
+				 * "drops Sync without valid RX timestamp" once per Sync, the
+				 * 1588 counter free-runs from boot, and every status field
+				 * still reads healthy because TX timestamping is unaffected
+				 * and Sync/Follow_Up/Delay_Req/Delay_Resp all complete -- a
+				 * tcpdump looks perfect. Whether you win the race depends on
+				 * instruction timing, so it is BUILD-DETERMINISTIC: adding 64
+				 * bytes of unrelated code flipped one image from 8/8 boots
+				 * synced to 4/4 failed. That is why it presents as flaky.
+				 *
+				 * Since the flag is a promise, waiting is CORRECT rather than
+				 * speculative -- but bounded, because trusting hardware to
+				 * always keep a promise is how you get an unbounded spin in an
+				 * RX thread. Writeback is sub-microsecond; the cap is orders
+				 * of magnitude beyond that and simply gives up if it is
+				 * missed, preserving the old behaviour in that case.
+				 */
 				if ((desc->write.control3 & RX_STATUS1_VALID_FLAG) &&
-				    (desc->write.control1 & RX_TIMESTAMP_AVAILABLE_FLAG) &&
-				    !(ctx_desc->write.control3 & OWN_FLAG) &&
-				    (ctx_desc->write.control3 & RECEIVE_CONTEXT_DESCRIPTOR_FLAG)) {
+				    (desc->write.control1 & RX_TIMESTAMP_AVAILABLE_FLAG)) {
+					for (int spin = 0; spin < 256; spin++) {
+						if (!(ctx_desc->write.control3 & OWN_FLAG) &&
+						    (ctx_desc->write.control3 &
+						     RECEIVE_CONTEXT_DESCRIPTOR_FLAG)) {
+							ctx_ready = true;
+							break;
+						}
+						/* The descriptor is volatile, so each pass
+						 * re-reads it; the fence orders that read
+						 * against the DMA's write.
+						 */
+						barrier_dmem_fence_full();
+					}
+					if (!ctx_ready) {
+						LOG_WRN("RX timestamp promised but context "
+							"descriptor never arrived (idx %u)",
+							ctx_idx);
+					}
+				}
+
+				if (ctx_ready) {
