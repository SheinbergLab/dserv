diff --git a/subsys/net/lib/ptp/port.c b/subsys/net/lib/ptp/port.c
index 0a871738102..a62b4c05bb8 100644
--- a/subsys/net/lib/ptp/port.c
+++ b/subsys/net/lib/ptp/port.c
@@ -1310,6 +1310,8 @@ static int port_management_resp_tlv_fill(struct ptp_port *port,
 	struct ptp_tlv_mgmt *mgmt;
 	struct ptp_tlv_default_ds *tlv_dds;
 	struct ptp_tlv_parent_ds *tlv_pds;
+	struct ptp_tlv_current_ds *tlv_cds;
+	struct ptp_tlv_port_ds *tlv_prtds;
 	const struct ptp_parent_ds *pds = ptp_clock_parent_ds();
 	const struct ptp_current_ds *cds = ptp_clock_current_ds();
 	const struct ptp_default_ds *dds = ptp_clock_default_ds();
@@ -1339,8 +1341,18 @@ static int port_management_resp_tlv_fill(struct ptp_port *port,
 		memcpy(&tlv_dds->clk_quality, &dds->clk_quality, sizeof(tlv_dds->clk_quality));
 		break;
 	case PTP_MGMT_CURRENT_DATA_SET:
+		tlv_cds = (struct ptp_tlv_current_ds *)mgmt->data;
+
+		/* Copy member-by-member: the wire struct is __packed while
+		 * struct ptp_current_ds is not, so a bulk memcpy shifts every
+		 * field after steps_rm by the internal padding and reports
