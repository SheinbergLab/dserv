+		 */
 		length = sizeof(struct ptp_tlv_current_ds);
-		memcpy(mgmt->data, cds, sizeof(struct ptp_tlv_current_ds));
+		tlv_cds->steps_rm = cds->steps_rm;
+		tlv_cds->offset_from_tt = cds->offset_from_tt;
+		tlv_cds->mean_delay = cds->mean_delay;
 		break;
 	case PTP_MGMT_PARENT_DATA_SET:
 		tlv_pds = (struct ptp_tlv_parent_ds *)mgmt->data;
@@ -1365,8 +1377,26 @@ static int port_management_resp_tlv_fill(struct ptp_port *port,
 		memcpy(mgmt->data, tpds, sizeof(struct ptp_tlv_time_prop_ds));
 		break;
 	case PTP_MGMT_PORT_DATA_SET:
+		tlv_prtds = (struct ptp_tlv_port_ds *)mgmt->data;
+
+		/* Same packed-vs-unpacked hazard as CURRENT_DATA_SET above, and
+		 * worse here: state and delay_mechanism are enums (4 bytes
