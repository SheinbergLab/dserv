+		memcpy(&tlv_prtds->id, &port->port_ds.id, sizeof(tlv_prtds->id));
+		tlv_prtds->state = (uint8_t)port->port_ds.state;
+		tlv_prtds->log_min_delay_req_interval =
+			port->port_ds.log_min_delay_req_interval;
+		tlv_prtds->mean_link_delay = port->port_ds.mean_link_delay;
+		tlv_prtds->log_announce_interval = port->port_ds.log_announce_interval;
+		tlv_prtds->announce_receipt_timeout = port->port_ds.announce_receipt_timeout;
+		tlv_prtds->log_sync_interval = port->port_ds.log_sync_interval;
+		tlv_prtds->delay_mechanism = (uint8_t)port->port_ds.delay_mechanism;
+		tlv_prtds->log_min_pdelay_req_interval =
+			port->port_ds.log_min_pdelay_req_interval;
+		tlv_prtds->version = port->port_ds.version;
 		break;
 	case PTP_MGMT_PRIORITY1:
 		length = sizeof(dds->priority1);
