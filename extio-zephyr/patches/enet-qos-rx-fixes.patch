+/* Hand a descriptor back to the DMA with its read format FULLY rebuilt.
+ *
+ * read and write are a UNION over the same 16 bytes, and by the time software
+ * owns a descriptor the DMA has already written back over it -- so every word
+ * holds write-back STATUS, not read-format content. In particular
+ * read.buf1_addr (RDES0) now holds a VLAN word, the nanoseconds half of a
+ * timestamp, or zero, depending on which write-back format landed. Handing
+ * the slot back by setting only .control gives the DMA OWN + BUF1_ADDR_VALID
+ * over that stale word, and the next arriving frame is DMA'd through it:
+ *
+ *   W: RX buffer underrun / No new RX buf available
+ *   E: Fatal bus error: RX:4, TX:0
+ *
+ * after which the RX engine halts and only a reset recovers the box -- the
+ * long-standing "dserv.live=down, does not self-heal, fixed instantly by an
+ * SWD reset" symptom. Reproduced on demand on an FRDM-MCXN947 by an OTA
+ * blast, the one traffic pattern that reliably drains the frag pool
+ * (2026-07-30; at CONFIG_NET_BUF_DATA_SIZE=128 a full-size frame spans 12 of
+ * the 16 descriptors, so a mid-frame drop hands back MANY stale slots).
+ *
+ * The buffer is still ours in every caller: no path swaps reserved_bufs[]
+ * without arming the new address in the same breath, so pointing RDES0 back
+ * at reserved_bufs[] is always correct. RDES1/RDES2 are rewritten too, even
+ * though the DMA is documented to ignore them with BUF2_ADDR_VALID clear:
+ * correctness here must not depend on which write-back format last landed.
+ * The barrier orders the address words ahead of the OWN handover.
+ *
+ * CALLERS THAT READ THE SLOT MUST READ FIRST: for a context descriptor,
+ * RDES0/RDES1 are exactly the timestamp words this rewrite destroys.
+ */
+static void rx_desc_rearm(struct nxp_enet_qos_rx_data *rx_data, uint32_t desc_idx)
+{
+	volatile union nxp_enet_qos_rx_desc *desc = &rx_data->descriptors[desc_idx];
+
+	desc->read.buf1_addr = (uint32_t)rx_data->reserved_bufs[desc_idx]->data;
+	desc->read.reserved = 0;
+	desc->read.buf2_addr = 0;
+	barrier_dmem_fence_full();
+	desc->read.control = rx_desc_refresh_flags;
+}
