[Unit]
# PTP grandmaster for the extio boxes. Templated on the interface, so one file
# serves every site:  dserv-ptp4l@eth0  (rig Pi)  ·  dserv-ptp4l@enp86s0 (office).
#
# Deliberately NOT named ptp4l.service: Debian's linuxptp package ships units by
# that name, and silently shadowing or being shadowed by a distro unit is a bad
# failure for something whose whole job is to be trustworthy.
#
# --hwts_filter full is REQUIRED, and not just on one NIC. ptp4l asks for
# HWTSTAMP_FILTER_PTP_V2_EVENT by default; a NIC that advertises only `none` and
# `all` never honours it, so every event message arrives WITHOUT a timestamp and
# mean_delay / offset_from_tt sit at 0 -- a confident-looking, meaningless
# result. Both NICs measured so far are like this (Pi 5 macb, Intel I226-V igc).
# Check `ethtool -T <iface>` on any new host before assuming the default works.
#
# --priority1 127 makes this host the grandmaster. The boxes are slaves and need
# no configuration; they discipline their ENET 1588 counters to this PHC.
#
# NOTE on scheduling: no CPUSchedulingPolicy here, unlike dserv.service. Every
# PTP figure in extio-zephyr/PORTING.md (±100 ns direct, ±352 ns through the
# switch) was measured with ptp4l at DEFAULT priority. Adding RT scheduling would
# invalidate that baseline and could contend with dserv's own fifo/60 threads.
# Change it only alongside a re-measurement.
Description=PTP grandmaster (ptp4l) on %i for extio time sync
Documentation=file:/usr/local/dserv/extio-zephyr/PORTING.md
Wants=network-online.target
After=network-online.target sys-subsystem-net-devices-%i.device

# Deliberately NOT BindsTo= the device. A dependency-stop is not a failure, so
# Restart= does NOT recover from it -- a NIC flap or a driver reload would take
# PTP down permanently and silently, which is the exact outcome these units
# exist to prevent. `After=` orders startup; Restart=always rides out flaps
# (ptp4l exits when the interface vanishes and is simply restarted until it
# comes back).

[Service]
Type=simple
# NO -2 HERE, AND THAT IS DELIBERATE -- it was added and then removed on
# 2026-07-29, so this comment exists to stop it coming back.
#
# The MCXN947 boxes appeared to need L2 (-2) because UDP/IPv4 "never got an RX
# timestamp". The real cause was a race in the Zephyr ENET_QOS driver's RX
# context-descriptor handling, fixed by
# extio-zephyr/patches/enet-qos-rx-timestamp-race.patch. Whether the timestamp
# survived depended on instruction timing, i.e. it was BUILD-DETERMINISTIC, and the
# L2-vs-UDP comparison changed the binary too -- so L2 got the credit for a lucky
# code layout. With the patch, UDP/IPv4 converges 8/8 cold boots.
#
# Keeping the default transport matters for the FLEET: RW612 boxes do not override
# it, so they speak UDP. One ptp4l on the default transport serves every box. Adding
# -2 here silently stops every UDP box from syncing -- and a transport mismatch
# produces TOTAL SILENCE rather than an error, which is harder to diagnose than the
# bug it was meant to work around.
ExecStart=/usr/sbin/ptp4l -i %i -H -m -q --priority1 127 --hwts_filter full
Restart=always
RestartSec=5

# -m prints to stdout, which journald captures. -q is what actually stops the
# DUPLICATION: -m does not disable syslog, so without it linuxptp logs every
# message twice into the journal -- once via stdout and once via syslog. Verified
# on the rig 2026-07-28 before adding it.
# This replaces host/start_ptp.sh, which setsid'd into /tmp/ptp4l.log with no
# supervision and did not survive a host reboot.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
