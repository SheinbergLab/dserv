[Unit]
Description=Dataserver Service
After=network-online.target seatd.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/dserv/dserv -c /usr/local/dserv/config/dsconf.tcl -t /usr/local/dserv/config/triggers.tcl
Restart=on-failure
RestartSec=10
KillMode=process

# Cap the stop wait. dserv's own teardown is bounded (subprocesses are told to
# stop without waiting on them; the log writers get a bounded drain), so if we
# are still here after 20s something is genuinely stuck and waiting out the
# 90s default only delays reboot.
TimeoutStopSec=20

# RT scheduling
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=60

# Lock memory to prevent paging latency
LimitMEMLOCK=infinity

# Logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target


