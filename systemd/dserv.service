[Unit]
Description=Dataserver Service
# network-online.target keeps first-boot registry sync from racing DHCP on
# connected rigs. On an AIR-GAPPED box it makes boot wait out the
# wait-online timeout (~2 min) — don't edit this unit there; instead mask
# the waiter (see docs/OFFLINE.md):
#   sudo systemctl mask systemd-networkd-wait-online NetworkManager-wait-online
After=network-online.target seatd.service
Wants=network-online.target
# Ordered after chrony so the waitsync below has a daemon to ask. After= on a
# unit that does not exist is harmless (timesyncd hosts, no NTP at all).
After=chrony.service chronyd.service

[Service]
Type=simple
# Do not start until chrony has settled the clock. dserv's now() is
# CLOCK_MONOTONIC plus an epoch offset captured once at startup, and on
# Linux CLOCK_MONOTONIC follows chrony's frequency slews. So a host that
# boots a few hundred ms wrong and is slewed into place -- rig1-dserv,
# 2026-10-26: 300 ms over ~50 min at maxslewrate 100 -- slides every
# dserv timestamp against the display host's clock for the whole session,
# and nothing in the file says so. waitsync blocks until the remaining
# correction is under 1 ms, trying once a second for up to 60 s.
# ALL FOUR arguments: the interval defaults to 10 s, so `waitsync 60 0.001`
# alone is a 600 s stall. The `-` prefix keeps a host with no chronyc, or
# no reachable time source (air-gapped, grandmaster down), starting anyway
# once the 60 s are up -- late is recoverable, never starting is not.
# Pair with `makestep 0.01 3` in chrony.conf so a boot-time error is
# stepped before this runs instead of slewed under the session.
ExecStartPre=-/usr/bin/chronyc waitsync 60 0.001 0 1
ExecStart=/usr/local/dserv/dserv -c /usr/local/dserv/config/dsconf.tcl -t /usr/local/dserv/config/triggers.tcl
Restart=on-failure
RestartSec=10
KillMode=process

# uWS caps total request headers at 4096 by default and answers 431 past that.
# Reaching a box by an FQDN inside a cookie-bearing domain (hm-0.devices.brown.edu
# picks up every cookie scoped to .brown.edu -- Shibboleth sessions alone are
# multi-KB) overruns that, while the bare IP does not, because an IP literal
# matches no cookie domain. Read by uWS at static-init from the environment.
Environment=UWS_HTTP_MAX_HEADERS_SIZE=32768

# Cap the stop wait. dserv's own teardown is bounded (subprocesses are told to
# stop without waiting on them; the log writers get a bounded drain), so if we
# are still here after 20s something is genuinely stuck and waiting out the
# 90s default only delays reboot.
TimeoutStopSec=20

# RT scheduling
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=60

# Lock memory to prevent paging latency
LimitMEMLOCK=infinity

# Logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target


