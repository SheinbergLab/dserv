#
# Per-rig camera tuning -- copy to local/camera.tcl and adjust.
#
# You do NOT need this file to use the camera. The command set
# (start/stop/set_interval/grab_full/...), the /camera.html page, and the
# declared rig facts all live in config/cameraconf.tcl now:
#
#   setting camera enabled  0|1          start streaming at boot (the gear
#                                        flips it live)
#   setting camera rotation 0|90|180|270 mounting rotation
#
# both editable from the settings gear (persisted in local/rig.tcl). This
# file is only for tuning the conf does not declare. It is sourced by the
# camera subprocess BEFORE the declarations, so a declared value always wins
# over anything set here.
#

# Publish cadence: stream at stream_fps, publish a snapshot every
# snapshot_interval seconds (skip-rate quantized). These are the defaults;
# uncomment to change.
#
# set stream_fps 30.0
# set snapshot_interval 1.0

# Sensor tuning that must land between cameraConfigure and streaming --
# define camera_tune and `start` calls it at the right moment. Uncomment
# what the rig needs.
#
# proc camera_tune {} {
#     # Lock exposure
#     cameraSetAutoExposure 0
#     cameraSetExposureTime 15000
#     cameraSetAnalogGain 2.0
#
#     # Lock white balance for consistent color (green is always 1.0)
#     cameraSetAutoWhiteBalance 0
#     cameraSetRedGain 1.8
#     cameraSetBlueGain 1.5
#
#     # Adjust sharpness
#     cameraSetSharpness 1.3
# }

# Anything more exotic (a different resolution, a second camera) can
# redefine `start` wholesale here -- old full copies of this EXAMPLE did
# exactly that and still work.
