# PREEMPT_RT fragment for the NXP Debian Linux SDK kernel (linux-imx lf-6.12.49-2.2.0).
#
# No external RT patch series is needed: PREEMPT_RT is mainline as of 6.12, and
# NXP's lf-6.12.y tree carries it (kernel/Kconfig.preempt: PREEMPT_RT depends on
# EXPERT && ARCH_SUPPORTS_RT, which arm64 sets).
#
# flexbuild copies this file into arch/arm64/configs/ and passes it as an extra
# make target after imx_v8_defconfig, so the kernel's own merge_config path
# applies it.  PREEMPT_* is a Kconfig *choice*, so the other members are
# explicitly cleared rather than left to the merge to resolve.

CONFIG_EXPERT=y
# CONFIG_PREEMPT_NONE is not set
# CONFIG_PREEMPT_VOLUNTARY is not set
# CONFIG_PREEMPT is not set
CONFIG_PREEMPT_RT=y

CONFIG_HIGH_RES_TIMERS=y

# Latency instrumentation -- osnoise/timerlat back the `rtla` tools, which are a
# better measure of this workload than cyclictest alone.
CONFIG_FTRACE=y
CONFIG_HWLAT_TRACER=y
CONFIG_OSNOISE_TRACER=y
CONFIG_TIMERLAT_TRACER=y
