[Unit]
# PTP CLIENT (slave) on %i -- the mirror of dserv-ptp4l@%i.
#
# Use this on a dserv host that is NOT the site's time source: a second
# acquisition machine, a stim host, anything that must share the grandmaster's
# timeline rather than define it. Exactly one host per site runs the
# dserv-ptp4l@ (grandmaster) unit; everything else runs this.
#
# A CLIENT NEEDS NO ADDRESS. That is PTP's advantage over NTP: the grandmaster
# announces, and BMCA elects it. The only value that must MATCH the grandmaster
# is the domain number (0 by default, hence not spelled out here) -- get that
# wrong and the client sees no master at all rather than a wrong one.
#
# -s (slaveOnly) is the whole difference, and it is a safety property, not a
# preference: without it this host joins the election and can WIN, quietly
# becoming the site's time source when the real grandmaster reboots. The
# timeline would then re-base under everyone -- exactly the clock step
# ptp/d_delta_us exists to detect. slaveOnly makes that impossible rather than
# unlikely.
#
# --hwts_filter is chosen per clock, as in the grandmaster unit: `full` where
# the NIC advertises only `none` and `all` (it never honours the default
# PTP_V2_EVENT filter, and every event message arrives untimestamped while
# offsets sit at a confident-looking 0), `normal` where it offers no `all` at
# all (Intel X710/i40e: `full` gets SIOCSHWTSTAMP ERANGE -> port FAULTY).
# ExecStartPre writes the choice to /run/dserv-ptp/%i.env; absent, it is `full`.
#
# And, as there, that filter list belongs to the selected CLOCK: an interface can
# expose both a MAC and a PHY PHC, and the kernel's default choice can be the one
# that rejects `full` outright. The ExecStartPre below picks the MAC's own clock
# first and only then reads its filter list, so a FAULTY port on such a host is
# fixed by the clock selection -- never by forcing the filter down to `normal`.
#
# A hand-written drop-in overriding ExecStart= with `--hwts_filter normal` (the
# interim i40e workaround on the psychophysics tracker) is superseded by this;
# delete it and daemon-reload.
#
# $PTP4L_COMPAT: the same PTPv2.0 wire pin as the grandmaster unit, probed and
# written by the same ExecStartPre (empty on linuxptp 3.x, which has no such
# option and speaks v2.0 anyway). A client needs it too: its Delay_Req is an
# event message, and a v2.1 one is as untimestamped at an X710 grandmaster as a
# v2.1 Sync is at an X710 client.
Description=PTP client (ptp4l slaveOnly) on %i
Documentation=file:/usr/local/dserv/extio-zephyr/PORTING.md
Wants=network-online.target
After=network-online.target sys-subsystem-net-devices-%i.device

# Not BindsTo= the device -- see dserv-ptp4l@.service for why: a dependency-stop
# is not a failure, so Restart= would not recover from a NIC flap.

# Mutually exclusive with the grandmaster unit on the same interface. Two ptp4l
# instances on one PHC fight, and it presents as drift rather than as an error.
Conflicts=dserv-ptp4l@%i.service

[Service]
Type=simple
# Same clock + filter selection as the grandmaster unit -- a client is if anything more
# exposed to getting this wrong, since a client on the wrong PHC still elects a
# master and still prints offsets. See dserv-ptp4l@.service.
# The filter and wire-version pin it chose are read from the env file; see
# dserv-ptp4l@.service.
# $PTP4L_COMPAT stays unbraced so an empty value adds no argument.
Environment=HWTS_FILTER=full
Environment=PTP4L_COMPAT=
EnvironmentFile=-/run/dserv-ptp/%i.env
ExecStartPre=-/usr/local/dserv/scripts/dserv-ptp-select-phc %i
ExecStart=/usr/sbin/ptp4l -i %i -H -m -q -s --hwts_filter ${HWTS_FILTER} $PTP4L_COMPAT
Restart=always
RestartSec=5

# -q suppresses the syslog copy; without it -m makes journald record every line
# twice. See the grandmaster unit.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
