{
  "components": [
    {
      "id": "dlsh",
      "name": "dlsh",
      "description": "Tcl zipfs library (shared runtime)",
      "repo": "SheinbergLab/dlsh",
      "assetPattern": "dlsh.*\\.zip$",
      "installCmd": "mkdir -p /usr/local/dlsh && cp {file} /usr/local/dlsh/dlsh.zip && echo {version} > /usr/local/dlsh/VERSION",
      "versionFile": "/usr/local/dlsh/VERSION"
    },
    {
      "id": "dserv",
      "name": "dserv",
      "description": "Data server and experiment control backend",
      "repo": "SheinbergLab/dserv",
      "package": "dserv",
      "service": "dserv",
      "assetPattern": "dserv_.*\\.deb$",
      "depends": ["dlsh"]
    },
    {
      "id": "stim2",
      "name": "stim2",
      "description": "Stimulus presentation system",
      "repo": "SheinbergLab/stim2",
      "package": "stim2",
      "service": "stim2",
      "assetPattern": "stim2_.*\\.deb$",
      "depends": ["dlsh"]
    },
    {
      "id": "dserv-agent",
      "name": "dserv-agent",
      "description": "Management agent (this program)",
      "repo": "SheinbergLab/dserv",
      "package": "dserv-agent",
      "assetPattern": "dserv-agent_.*\\.deb$",
      "followsComponent": "dserv"
    },
    {
      "id": "dserv-camera",
      "name": "dserv Camera",
      "description": "CSI camera capture subsystem",
      "repo": "SheinbergLab/dserv",
      "package": "dserv-camera-rpi",
      "assetPattern": "dserv-camera-rpi_.*\\.deb$",
      "depends": ["dserv"],
      "optional": true,
      "detectCmd": ["sh", "-c", "cat /sys/bus/i2c/devices/*/name 2>/dev/null | grep -qiE '^(imx|ov|arducam)'"]
    }
  ]
}
