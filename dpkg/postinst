#!/bin/sh

set -e

# Transitional companion to preinst: put the management agent back if this
# upgrade removed it.
#
# dserv used to ship /usr/local/bin/dserv-agent; it is now the dserv-agent
# package. dpkg deletes files the old version owned and the new one does not,
# so without this an in-cage box would take a routine dserv update and lose the
# only thing that can reach it afterwards.
#
# Restores the FILE and deliberately does NOT restart dserv-agent.service. On a
# box updating itself through the panel, the agent is the process running this
# very transaction -- restarting it here would kill dpkg mid-configure. The
# running agent keeps its old inode and carries on; the restored binary is
# simply there for the next start.
#
# Only fires when nothing else provides the path, so a box that has already
# moved to the dserv-agent package is untouched.
if [ ! -e /usr/local/bin/dserv-agent ] && \
   [ -e /var/lib/dserv/dserv-agent.preupgrade ]; then
    if install -m 0755 /var/lib/dserv/dserv-agent.preupgrade \
                       /usr/local/bin/dserv-agent 2>/dev/null; then
        echo "dserv: restored /usr/local/bin/dserv-agent (now provided by the dserv-agent package)"
    fi
fi
rm -f /var/lib/dserv/dserv-agent.preupgrade

# Migrate the box to the dserv-agent PACKAGE, and reload the component list.
#
# The agent used to ship inside this package and is now its own. Boxes are
# deployed across sites, many of them not reachable in person, so "install the
# new package by hand, once per box" is not a migration plan -- it is a list of
# machines that quietly never get migrated. This package is the only channel
# that reaches a box whose agent predates all of this, so it carries the step.
#
# It cannot be done here: dpkg holds its lock until this script returns, so any
# apt/dpkg call from inside it deadlocks. And on a box updating through the
# panel the agent IS the process running this transaction, so restarting it
# inline would kill dpkg mid-configure. Both problems have the same answer as
# the agent's own self-update -- hand the work to systemd and get out of the
# way. Twenty seconds is enough for the transaction to finish and for the agent
# to report the install it just performed.
#
# The script is written to disk rather than inlined so a box that fails to
# migrate can be diagnosed after the fact instead of guessed at.
#
# Entirely best-effort. No systemd, no network, an unreachable release: none of
# them are worth failing a dserv install for, and none of them leave the box
# worse off -- the preinst/postinst pair above has already guaranteed it still
# has a working agent binary either way.
if command -v systemctl >/dev/null 2>&1 && command -v systemd-run >/dev/null 2>&1; then
    mkdir -p /var/lib/dserv
    cat > /var/lib/dserv/agent-migrate.sh <<'MIGRATE'
#!/bin/sh
# Deferred by dserv's postinst. Brings the dserv-agent package into step with
# the dserv just installed, then restarts the agent so it picks up both the new
# binary and the component list this dserv shipped.
#
# In step, not merely present. The two ship from one tag and nobody chooses to
# run an old agent against a new dserv -- but they will neglect to update it,
# and there is one failure that guarantees they cannot: a broken self-updater.
# The agent is the component that performs updates, so it is the one component
# whose breakage removes its own route to a fix. 0.51.1 shipped exactly that,
# handing a PrivateTmp path to a transient unit that could not see it, and
# every affected box needed hands. This is the path that does not go through
# the agent, so it is the one that can heal it.
log() { logger -t dserv-agent-migrate "$*" 2>/dev/null || true; }

# From the installed dserv: dpkg has already recorded the new version by the
# time postinst runs, so this cannot drift from the release that scheduled it
# the way a build-time constant could.
VER=$(dpkg-query -W -f='${Version}' dserv 2>/dev/null || echo "")
ARCH=$(dpkg --print-architecture 2>/dev/null || echo "")

# Only a properly installed package counts as a version -- half-configured or
# unpacked reports nothing and gets reinstalled, the same rule the bootstrap
# uses, and for the same reason: a package can sit at the right version and
# still be broken.
AGENT_VER=""
case "$(dpkg-query -W -f='${Status}|${Version}' dserv-agent 2>/dev/null)" in
    "install ok installed|"*) AGENT_VER=$(dpkg-query -W -f='${Version}' dserv-agent 2>/dev/null) ;;
esac

WANT=""
if [ -z "$VER" ] || [ -z "$ARCH" ]; then
    log "could not determine dserv version/arch; skipping"
elif [ -z "$AGENT_VER" ]; then
    WANT="$VER"; log "dserv-agent not installed; fetching ${VER}"
elif dpkg --compare-versions "$AGENT_VER" lt "$VER"; then
    WANT="$VER"; log "dserv-agent ${AGENT_VER} older than dserv ${VER}; upgrading"
else
    # Equal, or NEWER. Newer is deliberate and left alone: a hand-installed
    # agent ahead of dserv is how a box gets rescued when self-update breaks,
    # and dragging it backwards would undo the rescue.
    log "dserv-agent ${AGENT_VER} in step with dserv ${VER}; nothing to do"
fi

if [ -n "$WANT" ]; then
    URL="https://github.com/SheinbergLab/dserv/releases/download/${WANT}/dserv-agent_${WANT}_${ARCH}.deb"
    TMP=$(mktemp -d)
    if curl -fsSL -o "$TMP/dserv-agent.deb" "$URL"; then
        # Lock::Timeout so this waits for a concurrent install rather than
    # failing: this unit fires 20s after a dserv install, which is exactly
    # when someone may be installing something else from the panel.
    if apt-get install -y -o DPkg::Lock::Timeout=300 "$TMP/dserv-agent.deb" >/dev/null 2>&1 ||
           dpkg -i "$TMP/dserv-agent.deb" >/dev/null 2>&1; then
            log "installed dserv-agent ${WANT} (${ARCH})"
        else
            log "dserv-agent ${WANT} downloaded but would not install"
        fi
    else
        log "could not fetch ${URL}"
    fi
    rm -rf "$TMP"
fi

# Always, even when nothing was installed: the component list this dserv
# shipped is read only at agent startup, and an unread list is why the panel
# would not offer the package in the first place.
systemctl restart dserv-agent 2>/dev/null || true

MIGRATE
    chmod 0755 /var/lib/dserv/agent-migrate.sh
    systemd-run --collect --on-active=20 \
        --unit=dserv-agent-migrate \
        /var/lib/dserv/agent-migrate.sh >/dev/null 2>&1 || true
fi

# Refresh dynamic lib cache for libs installed with package.
ldconfig

# Let non-root user access default dserv database file.
mkdir -p /usr/local/dserv/db
chmod a+w /usr/local/dserv/db

# Install the extio-box udev rule (the /usr/local package prefix is not a path
# udev scans) so the box's CDC is dialout-accessible and ModemManager ignores
# it. Copy + reload; harmless if the payload or udev is absent.
if [ -f /usr/local/dserv/udev/60-extio.rules ] && [ -d /etc/udev/rules.d ]; then
    install -m 0644 /usr/local/dserv/udev/60-extio.rules /etc/udev/rules.d/60-extio.rules
    if command -v udevadm >/dev/null 2>&1; then
        udevadm control --reload-rules 2>/dev/null || true
        udevadm trigger --subsystem-match=tty 2>/dev/null || true
    fi
fi

# Install dserv.service and the PTP unit TEMPLATES (/usr/local is not a path
# systemd scans, same reason the udev rule above needs copying).
#
# The PTP files are safe to place unconditionally because they are templates: a
# `foo@.service` with no instance cannot start, so this copies inert files.
# Nothing PTP-related runs until an operator picks an interface and a role with
# `dserv-ptp-setup`, which is a site decision the installer cannot make -- the
# interface is unknowable here, and "grandmaster" is a network-wide role, not a
# host preference.
#
# dserv.service USED to be excluded here, on the reasoning that a non-templated
# unit in /etc/systemd/system can be enabled and started by later tooling. That
# conflated two separate things. Shipping a unit file is not starting a daemon:
# this copies it and stops, exactly as before -- no enable, no start, so
# `apt install dserv` still leaves nothing running. What the exclusion actually
# bought was a box where `systemctl enable --now dserv` fails with no such unit,
# which is precisely how the amd64/trixie bootstrap ended (dserv-dev,
# 2026-08-24): the provisioner reported "dserv failed to enable/start" and then
# "dserv not running", every message aimed at dserv, none of them saying the
# unit had never been installed. dserv-agent's unit is written by the bootstrap
# and stim2's is installed by its own postinst -- dserv was the odd one out, and
# the asymmetry cost a provision.
#
# Absent only, never clobber: a unit in /etc/systemd/system is admin territory,
# and site edits (or an older install-dserv-service.sh copy) must survive an
# upgrade. Same rule stim2's postinst uses for its own unit.
if [ -d /usr/local/dserv/systemd ] && [ -d /etc/systemd/system ]; then
# NOTE the `|| true` on every step. This script runs under `set -e`, so an
# unguarded failure here aborts package configuration and leaves dserv
# half-installed -- a steep price for an OPTIONAL convenience on a host that may
# have no interest in PTP at all. Failing to place a unit template must never
# cost you the dataserver.
    if [ -f /usr/local/dserv/systemd/dserv.service ] && \
       [ ! -e /etc/systemd/system/dserv.service ]; then
        install -m 0644 /usr/local/dserv/systemd/dserv.service \
                        /etc/systemd/system/dserv.service || true
    fi
    for u in /usr/local/dserv/systemd/dserv-ptp4l*@.service \
             /usr/local/dserv/systemd/dserv-phc2sys*@.service; do
        [ -f "$u" ] || continue
        install -m 0644 "$u" /etc/systemd/system/ || true
    done
    if command -v systemctl >/dev/null 2>&1; then
        systemctl daemon-reload 2>/dev/null || true
    fi
fi

# Mask Debian's fluidsynth USER service, once.
#
# We Depend on fluidsynth for the library; Debian's package also ships
# /usr/lib/systemd/user/fluidsynth.service and globally enables it, so every
# dserv box quietly gains a second General MIDI daemon in each login session
# (`fluidsynth -is -r 48000 -z 512 default-GM.sf3`, listening on :9800).
#
# That is not merely redundant, it is a card thief. dserv's sound module opens
# its output EXCLUSIVELY and never releases it (ALSA hw/plughw is an exclusive
# open -- see the audio notes), so whichever synth reaches the device first
# keeps it. On dserv-dev (2026-08-24) dserv happened to win and the stray held
# only /dev/snd/seq, which is exactly what makes this dangerous: it is a RACE,
# not a fault. Linger=no means the daemon appears and disappears with a login,
# so a box can be silent only on the days somebody happened to be logged in
# when dserv started -- the kind of intermittency nobody debugs successfully.
#
# MASK, not disable. `systemctl --global disable` just removes the wants-symlink
# that fluidsynth's own maintainer script created, and deb-systemd-helper is
# entitled to put it back on the next fluidsynth upgrade. A mask is a /dev/null
# symlink in /etc/systemd/user, which outranks /usr/lib/systemd/user and cannot
# be started by any user by any route.
#
# ONCE, tracked by a marker, unlike the unit installs above. Unmasking this is a
# legitimate thing for an admin to want -- somebody may genuinely want a MIDI
# synth on a dev box -- and re-masking it on every dserv update would be us
# winning an argument with the operator. First install converges the fleet;
# after that the decision is theirs. The marker is only written if the mask
# actually succeeded, so a failure retries next time instead of being recorded
# as done.
if command -v systemctl >/dev/null 2>&1 && \
   [ -f /usr/lib/systemd/user/fluidsynth.service ] && \
   [ ! -e /var/lib/dserv/fluidsynth-user-masked ]; then
    if mkdir -p /var/lib/dserv 2>/dev/null && \
       systemctl --global mask fluidsynth.service >/dev/null 2>&1; then
        : > /var/lib/dserv/fluidsynth-user-masked 2>/dev/null || true
        echo "dserv: masked Debian's fluidsynth user service (it competes for the"
        echo "       exclusive ALSA device dserv plays through). To undo:"
        echo "           sudo systemctl --global unmask fluidsynth.service"
        echo "           sudo rm /var/lib/dserv/fluidsynth-user-masked"

        # A mask does not stop what is already running. Reach into each logged-in
        # user's own manager to stop it now, so the box does not stay in the
        # racy state until everyone logs out. Best-effort by design: no session
        # bus, no logind, a user without a running manager -- none of those are
        # worth a word, let alone a failed package configuration.
        if command -v loginctl >/dev/null 2>&1; then
            for _u in $(loginctl list-users --no-legend 2>/dev/null | awk '{print $2}'); do
                systemctl --machine="${_u}@.host" --user stop fluidsynth.service \
                    >/dev/null 2>&1 || true
            done
        fi
    fi
fi

# Put the PTP helpers on PATH; they are otherwise buried in the payload.
#
# dserv-ptp-select-phc must be EXECUTABLE even though nobody runs it by hand: the
# ptp4l units call it from ExecStartPre. That is a `-` prefix, so a missing +x
# would not fail the unit -- it would silently skip the clock selection and leave
# PTP running against the wrong PHC, which is the exact failure it exists to
# prevent. Symlinked too, so `dserv-ptp-select-phc eth0` is available for
# diagnosis alongside dserv-ptp-setup.
for h in dserv-ptp-setup dserv-ptp-select-phc; do
    [ -f "/usr/local/dserv/scripts/$h" ] || continue
    chmod 0755 "/usr/local/dserv/scripts/$h" 2>/dev/null || true
    mkdir -p /usr/local/bin 2>/dev/null || true
    ln -sf "/usr/local/dserv/scripts/$h" "/usr/local/bin/$h" 2>/dev/null || true
done

# Time-source advisory. SAY, do not ACT: which NTP daemon a host runs is a site
# decision of the same class as the PTP role above, and installing chrony removes
# systemd-timesyncd -- not something `apt install dserv` should do behind your
# back. The package Recommends chrony, which is the right amount of force.
#
# Worth saying because both consequences are invisible. dserv's
# clock_epoch_offset_us() is captured ONCE at startup, so a host that boots with
# a wrong clock stamps every datapoint wrong for the life of the process and
# nothing self-heals it (rig Pi, 2026-08-09: 29 h of skew, every extio box read
# "offline" in the GUI while the rig was healthy). And on a PTP GRANDMASTER the
# choice of daemon is not academic -- measured on the i.MX95 GM 2026-08-08, 120
# samples of its own phc2sys: chrony sd 92 ns, systemd-timesyncd sd 53,042 ns,
# no NTP at all sd 77 ns. timesyncd is ~690x worse than having NO time source,
# because phc2sys pushes its frequency thrash into the PHC and out to every box.
if command -v systemctl >/dev/null 2>&1; then
    if [ "$(systemctl is-active chrony.service 2>/dev/null)" != active ] && \
       [ "$(systemctl is-active chronyd.service 2>/dev/null)" != active ]; then
        if [ "$(systemctl is-active systemd-timesyncd.service 2>/dev/null)" = active ]; then
            echo "NOTE: this host's time source is systemd-timesyncd. chrony is strongly"
            echo "      preferred -- 53 us vs 92 ns of jitter measured on a PTP grandmaster,"
            echo "      where it is pushed out to every extio box:"
            echo "          apt install chrony"
            echo "      On a grandmaster, also install the tuning drop-in:"
            echo "          cp /usr/local/dserv/systemd/chrony-grandmaster.conf \\"
            echo "             /etc/chrony/conf.d/10-dserv-grandmaster.conf"
        else
            echo "NOTE: no NTP daemon is active. dserv captures its wall-clock epoch ONCE at"
            echo "      startup, so a host that boots with a wrong clock timestamps everything"
            echo "      wrong until dserv is RESTARTED -- and nothing self-heals it:"
            echo "          apt install chrony"
        fi
    fi
fi

# Bootstrap dlsh if not already installed
if [ ! -f /usr/local/dlsh/dlsh.zip ]; then
    echo "dlsh not found, installing..."
    DLSH_URL=$(curl -s https://api.github.com/repos/SheinbergLab/dlsh/releases/latest \
        | grep "browser_download_url.*dlsh.*\.zip" \
        | head -1 | cut -d'"' -f4)

    if [ -n "$DLSH_URL" ]; then
        DLSH_VER=$(curl -s https://api.github.com/repos/SheinbergLab/dlsh/releases/latest \
            | grep '"tag_name"' | head -1 | cut -d'"' -f4)
        mkdir -p /usr/local/dlsh
        curl -fSL "$DLSH_URL" -o /usr/local/dlsh/dlsh.zip
        echo "$DLSH_VER" > /usr/local/dlsh/VERSION
        echo "Installed dlsh $DLSH_VER to /usr/local/dlsh/"
    else
        echo "Warning: could not determine dlsh download URL"
    fi
fi
