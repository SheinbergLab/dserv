#!/bin/sh

set -e

# Refresh dynamic lib cache for libs installed with package.
ldconfig

# Let non-root user access default dserv database file.
mkdir -p /usr/local/dserv/db
chmod a+w /usr/local/dserv/db

# Install the extio-box udev rule (the /usr/local package prefix is not a path
# udev scans) so the box's CDC is dialout-accessible and ModemManager ignores
# it. Copy + reload; harmless if the payload or udev is absent.
if [ -f /usr/local/dserv/udev/60-extio.rules ] && [ -d /etc/udev/rules.d ]; then
    install -m 0644 /usr/local/dserv/udev/60-extio.rules /etc/udev/rules.d/60-extio.rules
    if command -v udevadm >/dev/null 2>&1; then
        udevadm control --reload-rules 2>/dev/null || true
        udevadm trigger --subsystem-match=tty 2>/dev/null || true
    fi
fi

# Install the PTP systemd unit TEMPLATES (/usr/local is not a path systemd
# scans, same reason the udev rule above needs copying).
#
# Safe to do unconditionally because these are templates: a `foo@.service` with
# no instance cannot start, so this copies inert files. Nothing PTP-related runs
# until an operator picks an interface and a role with `dserv-ptp-setup`, which
# is a site decision the installer cannot make -- the interface is unknowable
# here, and "grandmaster" is a network-wide role, not a host preference.
#
# Deliberately does NOT glob dserv.service / dserv-agent.service: on Debian a
# non-templated unit that lands in /etc/systemd/system can be enabled and started
# by later tooling, and starting a daemon as a side effect of `apt install` is a
# different decision from shipping its unit file.
if [ -d /usr/local/dserv/systemd ] && [ -d /etc/systemd/system ]; then
    for u in /usr/local/dserv/systemd/dserv-ptp4l*@.service \
             /usr/local/dserv/systemd/dserv-phc2sys*@.service; do
        [ -f "$u" ] || continue
        install -m 0644 "$u" /etc/systemd/system/
    done
    if command -v systemctl >/dev/null 2>&1; then
        systemctl daemon-reload 2>/dev/null || true
    fi
fi

# Put the PTP role helper on PATH; it is otherwise buried in the payload.
if [ -f /usr/local/dserv/scripts/dserv-ptp-setup ] && [ -d /usr/local/bin ]; then
    chmod 0755 /usr/local/dserv/scripts/dserv-ptp-setup 2>/dev/null || true
    ln -sf /usr/local/dserv/scripts/dserv-ptp-setup /usr/local/bin/dserv-ptp-setup
fi

# Bootstrap dlsh if not already installed
if [ ! -f /usr/local/dlsh/dlsh.zip ]; then
    echo "dlsh not found, installing..."
    DLSH_URL=$(curl -s https://api.github.com/repos/SheinbergLab/dlsh/releases/latest \
        | grep "browser_download_url.*dlsh.*\.zip" \
        | head -1 | cut -d'"' -f4)

    if [ -n "$DLSH_URL" ]; then
        DLSH_VER=$(curl -s https://api.github.com/repos/SheinbergLab/dlsh/releases/latest \
            | grep '"tag_name"' | head -1 | cut -d'"' -f4)
        mkdir -p /usr/local/dlsh
        curl -fSL "$DLSH_URL" -o /usr/local/dlsh/dlsh.zip
        echo "$DLSH_VER" > /usr/local/dlsh/VERSION
        echo "Installed dlsh $DLSH_VER to /usr/local/dlsh/"
    else
        echo "Warning: could not determine dlsh download URL"
    fi
fi
